# tsqldump/test/Dockerfile.test

# Use an official lightweight Python image
FROM python:3.11-slim

# Set environment variables to avoid buffering and .pyc generation
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DB_HOST=localhost \
    DB_PORT=1433 \
    DB_USER=sa \
    DB_PASSWORD=YourSecurePassword123!

# Install system dependencies required for pymssql / FreeTDS and health checking
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    freetds-dev \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Set working directory inside the container
WORKDIR /app

# Copy requirements from root and install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy everything from project root (including tsqldump/main.py and test/)
COPY . .

# Set Python path so tsqldump package can be imported directly
ENV PYTHONPATH=/app/src

# Default command runs the integration test suite against the target DB container
CMD ["python3", "test/run_tests.py"]

